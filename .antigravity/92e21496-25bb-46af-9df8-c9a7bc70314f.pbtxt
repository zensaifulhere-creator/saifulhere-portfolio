           - generic [ref=e175]: Synergy Studio\n              - heading \"Synergy Creative AI Workspace\" [level=3] [ref=e176]\n              - paragraph [ref=e177]: Spatial node-graph workspace empowering creative teams to chain AI workflows, generate visual ideas, and curate multimodal assets.\n            - generic [ref=e178]:\n              - generic [ref=e179]:\n                - generic [ref=e180]: React 19\n                - generic [ref=e181]: /WebGL\n                - generic [ref=e182]: /TypeScript\n                - generic [ref=e183]: \"+2\"\n              - generic [ref=e184]: View Case Study \342\206\222\n        - article [ref=e185] [cursor=pointer]:\n          - img \"Preview screenshot of Aethel Monograph & Luxury Catalog\" [ref=e187]\n          - generic [ref=e193]:\n            - generic [ref=e194]:\n              - generic [ref=e195]:\n                - generic [ref=e196]: Web Architecture\n                - generic [aria-hidden] [ref=e197]: \302\267\n                - generic [ref=e198]: \"2024\"\n                - generic [aria-hidden] [ref=e199]: \302\267\n                - generic [ref=e200]: Aethel Atelier\n              - heading \"Aethel Monograph & Luxury Catalog\" [level=3] [ref=e201]\n              - paragraph [ref=e202]: High-end editorial digital showroom for an architectural atelier, emphasizing typography rhythm and cinematic image curation.\n            - generic [ref=e203]:\n              - generic [ref=e204]:\n                - generic [ref=e205]: React 19\n                - generic [ref=e206]: /Next.js\n                - generic [ref=e207]: /Tailwind CSS\n                - generic [ref=e208]: \"+2\"\n              - generic [ref=e209]: View Case Study \342\206\222\n        - article [ref=e210] [cursor=pointer]:\n          - img \"Preview screenshot of Nexus Design Token CLI & Studio\" [ref=e212]\n          - generic [ref=e218]:\n            - generic [ref=e219]:\n              - generic [ref=e220]:\n                - generic [ref=e221]: Design System Tool\n                - generic [aria-hidden] [ref=e222]: \302\267\n                - generic [ref=e223]: \"2025\"\n              - heading \"Nexus Design Token CLI & Studio\" [level=3] [ref=e224]\n              - paragraph [ref=e225]: Developer utility translating Figma Variables into W3C Design Tokens, CSS Custom Properties, and typed TypeScript packages.\n            - generic [ref=e226]:\n              - generic [ref=e227]:\n                - generic [ref=e228]: TypeScript\n                - generic [ref=e229]: /Node.js\n                - generic [ref=e230]: /Figma REST API\n                - generic [ref=e231]: \"+1\"\n              - generic [ref=e232]: View Case Study \342\206\222\n        - article [ref=e233] [cursor=pointer]:\n          - img \"Preview screenshot of Chronos Tactile Focus & Stopwatch\" [ref=e235]\n          - generic [ref=e241]:\n            - generic [ref=e242]:\n              - generic [ref=e243]:\n                - generic [ref=e244]: Interactive Prototype\n                - generic [aria-hidden] [ref=e245]: \302\267\n                - generic [ref=e246]: \"2024\"\n              - heading \"Chronos Tactile Focus & Stopwatch\" [level=3] [ref=e247]\n              - paragraph [ref=e248]: A keyboard-first time-blocking tool with tactile synthesized clicks and analog stopwatch visual aesthetics.\n            - generic [ref=e249]:\n              - generic [ref=e250]:\n                - generic [ref=e251]: React 19\n                - generic [ref=e252]: /Web Audio API\n                - generic [ref=e253]: /Tailwind CSS\n                - generic [ref=e254]: \"+1\"\n              - generic [ref=e255]: View Case Study \342\206\222\n    - generic [ref=e257]:\n      - generic [ref=e258]:\n        - generic [ref=e259]:\n          - generic [ref=e260]:\n            - generic [ref=e261]:\n              - generic [ref=e262]: 02 / Methodology\n              - generic [aria-hidden] [ref=e263]: \302\267\n              - generic [ref=e264]: The Workflow\n            - heading \"HOW I DESIGN & CODE\" [level=2] [ref=e265]\n          - paragraph [ref=e266]: From initial user research to production React deployment, every phase is engineered to eliminate handoff friction and maximize adoption.\n        - generic [ref=e267]:\n          - generic [ref=e268]:\n            - generic [ref=e269]:\n              - generic [ref=e270]:\n                - generic [ref=e271]: \"01\"\n                - generic [ref=e272]: Phase 1\n              - heading \"Strategic Discovery & UX Mapping\" [level=3] [ref=e273]\n              - paragraph [ref=e274]: Auditing product friction, identifying mental models, and interviewing stakeholders to define concrete UX success metrics.\n            - generic [ref=e275]:\n              - generic [ref=e276]: \"Core Deliverables:\"\n              - generic [ref=e277]:\n                - generic [ref=e278]: User journey maps\n                - generic [ref=e279]:\n                  - generic [ref=e280]: \302\267\n                  - text: Problem statements\n                - generic [ref=e281]:\n                  - generic [ref=e282]: \302\267\n                  - text: Interaction benchmarks\n          - generic [ref=e283]:\n            - generic [ref=e284]:\n              - generic [ref=e285]:\n                - generic [ref=e286]: \"02\"\n                - generic [ref=e287]: Phase 2\n              - heading \"Information Architecture & Wireframes\" [level=3] [ref=e288]\n              - paragraph [ref=e289]: Structuring layouts with low-fidelity blueprints to test spatial hierarchy, scan paths, and cognitive load before visual styling.\n            - generic [ref=e290]:\n              - generic [ref=e291]: \"Core Deliverables:\"\n              - generic [ref=e292]:\n                - generic [ref=e293]: Clickable wireframes\n                - generic [ref=e294]:\n                  - generic [ref=e295]: \302\267\n                  - text: Information hierarchy\n                - generic [ref=e296]:\n                  - generic [ref=e297]: \302\267\n                  - text: Navigation flows\n          - generic [ref=e298]:\n            - generic [ref=e299]:\n              - generic [ref=e300]:\n                - generic [ref=e301]: \"03\"\n                - generic [ref=e302]: Phase 3\n              - heading \"Design Tokens & Multi-Theme Systems\" [level=3] [ref=e303]\n              - paragraph [ref=e304]: Authoring mathematical color scales, fluid typographic ladders, and semantic elevation tokens synchronizable across Figma and code.\n            - generic [ref=e305]:\n              - generic [ref=e306]: \"Core Deliverables:\"\n              - generic [ref=e307]:\n                - generic [ref=e308]: Figma variables library\n                - generic [ref=e309]:\n                  - generic [ref=e310]: \302\267\n                  - text: W3C token exports\n                - generic [ref=e311]:\n                  - generic [ref=e312]: \302\267\n                  - text: Accessibility matrix\n          - generic [ref=e313]:\n            - generic [ref=e314]:\n              - generic [ref=e315]:\n                - generic [ref=e316]: \"04\"\n                - generic [ref=e317]: Phase 4\n              - heading \"Creative Code & Functional Prototyping\" [level=3] [ref=e318]\n              - paragraph [ref=e319]: Building high-fidelity interactive sandboxes using React, Tailwind CSS, and Framer Motion to validate gesture physics and tactile feedback.\n            - generic [ref=e320]:\n              - generic [ref=e321]: \"Core Deliverables:\"\n              - generic [ref=e322]:\n                - generic [ref=e323]: Live React prototypes\n                - generic [ref=e324]:\n                  - generic [ref=e325]: \302\267\n                  - text: Storybook components\n                - generic [ref=e326]:\n                  - generic [ref=e327]: \302\267\n                  - text: Micro-interaction physics\n          - generic [ref=e328]:\n            - generic [ref=e329]:\n              - generic [ref=e330]:\n                - generic [ref=e331]: \"05\"\n                - generic [ref=e332]: Phase 5\n              - heading \"Edge-Case Polish & Sensory Tuning\" [level=3] [ref=e333]\n              - paragraph [ref=e334]: Stress-testing dark mode contrast, zero-latency states, keyboard focus traps, screen reader landmarks, and fluid responsive reflow.\n            - generic [ref=e335]:\n              - generic [ref=e336]: \"Core Deliverables:\"\n              - generic [ref=e337]:\n                - generic [ref=e338]: WCAG AA compliance audit\n                - generic [ref=e339]:\n                  - generic [ref=e340]: \302\267\n                  - text: Reduced-motion fallbacks\n                - generic [ref=e341]:\n                  - generic [ref=e342]: \302\267\n                  - text: Touch target optimization\n          - generic [ref=e343]:\n            - generic [ref=e344]:\n              - generic [ref=e345]:\n                - generic [ref=e346]: \"06\"\n                - generic [ref=e347]: Phase 6\n              - heading \"Production Ship & Engineering Handoff\" [level=3] [ref=e348]\n              - paragraph [ref=e349]: Packaging production-ready code repositories with semantic documentation, zero dead clicks, and seamless developer onboarding.\n            - generic [ref=e350]:\n              - generic [ref=e351]: \"Core Deliverables:\"\n              - generic [ref=e352]:\n                - generic [ref=e353]: Clean Git repositories\n                - generic [ref=e354]:\n                  - generic [ref=e355]: \302\267\n                  - text: Figma spec inspections\n                - generic [ref=e356]:\n                  - generic [ref=e357]: \302\267\n                  - text: Component documentation\n      - generic [ref=e358]:\n        - generic [ref=e359]:\n          - generic [ref=e360]:\n            - generic [ref=e361]:\n              - generic [ref=e362]: 03 / Capabilities\n              - generic [aria-hidden] [ref=e363]: \302\267\n              - generic [ref=e364]: Craft & Tools\n            - heading \"SKILLS & STACK\" [level=2] [ref=e365]\n          - paragraph [ref=e366]: High-leverage engineering skills and industry-standard design tools backed by 6+ years of active production practice.\n        - generic [ref=e367]:\n          - generic [ref=e368]:\n            - heading \"UI/UX & Product Design\" [level=3] [ref=e370]\n            - list [ref=e371]:\n              - listitem [ref=e372]:\n                - generic [ref=e374]: Design Systems Architecture\n              - listitem [ref=e375]:\n                - generic [ref=e377]: Figma Variables & Components\n              - listitem [ref=e378]:\n                - generic [ref=e380]: High-Fidelity Wireframing\n              - listitem [ref=e381]:\n                - generic [ref=e383]: Information Architecture\n              - listitem [ref=e384]:\n                - generic [ref=e386]: WCAG AA/AAA Accessibility\n              - listitem [ref=e387]:\n                - generic [ref=e389]: User Journey Mapping\n          - generic [ref=e390]:\n            - heading \"Creative Frontend Engineering\" [level=3] [ref=e392]\n            - list [ref=e393]:\n              - listitem [ref=e394]:\n                - generic [ref=e396]: React 19 & Next.js\n              - listitem [ref=e397]:\n                - generic [ref=e399]: TypeScript Architecture\n              - listitem [ref=e400]:\n                - generic [ref=e402]: Tailwind CSS v4\n              - listitem [ref=e403]:\n                - generic [ref=e405]: Framer Motion & Micro-Interactions\n              - listitem [ref=e406]:\n                - generic [ref=e408]: HTML5 Canvas & Particle Swarms\n              - listitem [ref=e409]:\n                - generic [ref=e411]: Responsive Fluid Layouts\n          - generic [ref=e412]:\n            - heading \"Prototyping & Sensory UX\" [level=3] [ref=e414]\n            - list [ref=e415]:\n              - listitem [ref=e416]:\n                - generic [ref=e418]: Interactive Code Sandboxes\n              - listitem [ref=e419]:\n                - generic [ref=e421]: Haptic & Sound-Assisted UI\n              - listitem [ref=e422]:\n                - generic [ref=e424]: Design Token Pipelines\n              - listitem [ref=e425]:\n                - generic [ref=e427]: Keyboard Navigation & Focus Traps\n              - listitem [ref=e428]:\n                - generic [ref=e430]: Gesture Physics & Springs\n              - listitem [ref=e431]:\n                - generic [ref=e433]: State Machine Modeling\n        - generic [ref=e434]:\n          - heading \"Daily Software & Engineering Tooling\" [level=4] [ref=e435]\n          - generic [ref=e436]:\n            - generic [ref=e437]:\n              - paragraph [ref=e438]: Figma\n              - paragraph [ref=e439]: Design Systems & Prototypes\n            - generic [ref=e440]:\n              - paragraph [ref=e441]: React 19\n              - paragraph [ref=e442]: Component Architecture\n            - generic [ref=e443]:\n              - paragraph [ref=e444]: Tailwind CSS\n              - paragraph [ref=e445]: Design Tokens & Utility Layouts\n            - generic [ref=e446]:\n              - paragraph [ref=e447]: TypeScript\n              - paragraph [ref=e448]: Type-Safe Logic & Interfaces\n            - generic [ref=e449]:\n              - paragraph [ref=e450]: Framer Motion\n              - paragraph [ref=e451]: Fluid Animation & Physics\n            - generic [ref=e452]:\n              - paragraph [ref=e453]: Framer\n              - paragraph [ref=e454]: Interactive Visual Prototyping\n            - generic [ref=e455]:\n              - paragraph [ref=e456]: Canvas API\n              - paragraph [ref=e457]: Generative Particle Effects\n            - generic [ref=e458]:\n              - paragraph [ref=e459]: VS Code\n              - paragraph [ref=e460]: Daily Engineering Environment\n    - generic [ref=e462]:\n      - generic [ref=e463]:\n        - generic [ref=e464]:\n          - generic [ref=e465]:\n            - generic [ref=e466]:\n              - generic [ref=e467]: 04 / Experience\n              - generic [aria-hidden] [ref=e468]: \302\267\n              - generic [ref=e469]: Career History\n            - heading \"PROVEN EXPERIENCE\" [level=2] [ref=e470]\n          - paragraph [ref=e471]: 6+ years leading design systems, crafting interactive prototypes, and driving frontend architecture across global product teams.\n        - generic [ref=e472]:\n          - generic [ref=e473]:\n            - generic [ref=e474]:\n              - generic [ref=e475]:\n                - heading \"Lead Design Systems Engineer\" [level=3] [ref=e476]\n                - paragraph [ref=e477]: Apex Product Studio\n              - generic [ref=e478]: 2023 \342\200\224 Present\n            - paragraph [ref=e479]: Directing the core design token infrastructure and reusable component libraries powering 6 enterprise SaaS products across web and mobile.\n            - generic [ref=e480]:\n              - generic [ref=e481]: \"Key Achievements:\"\n              - list [ref=e482]:\n                - listitem [ref=e483]:\n                  - generic [ref=e487]: Unified 4 separate design silos into a single W3C token repository with automated CI exports.\n                - listitem [ref=e488]:\n                  - generic [ref=e492]: Mentored 18 designers and frontend engineers in design token governance and accessible React practices.\n                - listitem [ref=e493]:\n                  - generic [ref=e497]: Achieved 99.4% design token adoption across 140+ active screens.\n          - generic [ref=e498]:\n            - generic [ref=e499]:\n              - generic [ref=e500]:\n                - heading \"Senior UI/UX & Interactive Prototype Designer\" [level=3] [ref=e501]\n                - paragraph [ref=e502]: Vanguard Digital Lab\n              - generic [ref=e503]: 2021 \342\200\224 2023\n            - paragraph [ref=e504]: Spearheaded creative prototyping and micro-interaction design for high-growth fintech, crypto, and commerce clients.\n            - generic [ref=e505]:\n              - generic [ref=e506]: \"Key Achievements:\"\n              - list [ref=e507]:\n                - listitem [ref=e508]:\n                  - generic [ref=e512]: Designed and prototyped the Aura Mobile Banking application, earning 4.9 App Store rating.\n                - listitem [ref=e513]:\n                  - generic [ref=e517]: Created interactive React sandboxes that reduced user testing cycle time from 3 weeks to 4 days.\n                - listitem [ref=e518]:\n                  - generic [ref=e522]: Wrote custom spring-physics interaction libraries using Framer Motion and WebGL.\n          - generic [ref=e523]:\n            - generic [ref=e524]:\n              - generic [ref=e525]:\n                - heading \"UI/UX Designer & Creative Frontend Developer\" [level=3] [ref=e526]\n                - paragraph [ref=e527]: Omnia Creative Agency\n              - generic [ref=e528]: 2019 \342\200\224 2021\n            - paragraph [ref=e529]: Collaborated directly with founders and artistic directors to deliver award-winning brand websites, digital editorial platforms, and design systems.\n            - generic [ref=e530]:\n              - generic [ref=e531]: \"Key Achievements:\"\n              - list [ref=e532]:\n                - listitem [ref=e533]:\n                  - generic [ref=e537]: Delivered 22 client web applications with 100/100 Lighthouse performance scores.\n                - listitem [ref=e538]:\n                  - generic [ref=e542]: Co-created editorial layouts recognized on Awwwards and CSS Design Awards.\n      - generic [ref=e544]:\n        - generic [ref=e545]:\n          - generic [ref=e546]:\n            - generic [ref=e547]: 05 / Philosophy\n            - generic [aria-hidden] [ref=e548]: \302\267\n            - generic [ref=e549]: About Saiful\n          - heading \"BRIDGING DESIGN AESTHETICS & FRONTEND RIGOR\" [level=2] [ref=e550]\n          - generic [ref=e551]:\n            - paragraph [ref=e552]: With over 6 years of experience working at the intersection of product design and frontend engineering, I specialize in eliminating the gap between what designers imagine in Figma and what engineers ship in production.\n            - paragraph [ref=e553]: My approach is grounded in design token discipline, accessible WCAG standards, and sensory micro-interactions. Whether architecting a 60-component multi-brand system or crafting an experimental WebGL canvas, every interaction is engineered for speed, clarity, and tactile delight.\n          - generic [ref=e554]:\n            - generic [ref=e555]: Dhaka, Bangladesh \302\267 Available Worldwide\n            - generic [ref=e560]: Available for new projects & contracts\n        - generic [ref=e565]:\n          - heading \"MY THREE DESIGN INVARIANTS\" [level=3] [ref=e566]\n          - generic [ref=e567]:\n            - generic [ref=e568]:\n              - heading \"01. Zero Handoff Ambiguity\" [level=4] [ref=e569]:\n                - generic [ref=e570]: \"01.\"\n                - generic [ref=e571]: Zero Handoff Ambiguity\n              - paragraph [ref=e572]: Components and tokens are engineered together in parallel, eliminating the classic \"lost in translation\" gap between design files and web code.\n            - generic [ref=e573]:\n              - heading \"02. Sensory Micro-Interactions\" [level=4] [ref=e574]:\n                - generic [ref=e575]: \"02.\"\n                - generic [ref=e576]: Sensory Micro-Interactions\n              - paragraph [ref=e577]: Interfaces should feel alive. Tactile hover curves, spring physics, and keyboard responsiveness make software memorable.\n            - generic [ref=e578]:\n              - heading \"03. Accessible Without Compromise\" [level=4] [ref=e579]:\n                - generic [ref=e580]: \"03.\"\n                - generic [ref=e581]: Accessible Without Compromise\n              - paragraph [ref=e582]: Stunning typography and dark-mode elegance must never sacrifice 4.5:1 WCAG contrast, screen-reader semantics, or keyboard focus visibility.\n    - generic [ref=e584]:\n      - generic [ref=e585]:\n        - generic [ref=e586]:\n          - generic [ref=e587]: 06 / Collaboration\n          - generic [aria-hidden] [ref=e588]: \302\267\n          - generic [ref=e589]: Get in Touch\n        - heading \"LET\'S CRAFT SOMETHING MEMORABLE\" [level=2] [ref=e590]\n        - paragraph [ref=e591]: Have a product vision, an enterprise design system to build, or a creative frontend challenge? Reach out directly or dispatch a project proposal below.\n      - generic [ref=e592]:\n        - generic [ref=e594]:\n          - heading \"DIRECT CHANNELS\" [level=3] [ref=e595]\n          - generic [ref=e596]:\n            - generic [ref=e597]:\n              - generic [ref=e598]: Primary Email\n              - generic [ref=e599]:\n                - generic [ref=e600]: sifulabdullah@gmail.com\n                - button \"Copy\" [ref=e601]\n            - generic [ref=e606]:\n              - generic [ref=e607]: Location & Response Time\n              - paragraph [ref=e608]: Dhaka, Bangladesh \302\267 Available Worldwide\n              - paragraph [ref=e609]: \"Typical response time: within 24 hours.\"\n          - generic [ref=e610]:\n            - generic [ref=e611]: Verified Socials & Code\n            - generic [ref=e612]:\n              - link \"GitHub \302\267 @sifulabdullah\" [ref=e613] [cursor=pointer]:\n                - /url: https://github.com/sifulabdullah\n              - link \"LinkedIn \302\267 /in/siful-islam\" [ref=e618] [cursor=pointer]:\n                - /url: https://linkedin.com/in/siful-islam\n              - link \"Dribbble \302\267 @saifulislam\" [ref=e623] [cursor=pointer]:\n                - /url: https://dribbble.com/saifulislam\n              - link \"Behance \302\267 @saifulislam\" [ref=e628] [cursor=pointer]:\n                - /url: https://behance.net/saifulislam\n        - generic [ref=e635]:\n          - generic [ref=e636]:\n            - heading \"PROJECT INQUIRY\" [level=3] [ref=e637]\n            - generic [ref=e638]: All fields validated\n          - generic [ref=e639]:\n            - generic [ref=e640]:\n              - generic [ref=e641]: Your Name *\n              - textbox \"e.g. Alex Rivera\" [ref=e642]\n            - generic [ref=e643]:\n              - generic [ref=e644]: Business Email *\n              - textbox \"alex@company.com\" [ref=e645]\n          - generic [ref=e646]:\n            - generic [ref=e647]:\n              - generic [ref=e648]: Service Required\n              - combobox [ref=e649]:\n                - option \"Design Systems Architecture\" [selected]\n                - option \"Interactive Prototype Development\"\n                - option \"Full-Stack Creative Frontend\"\n                - option \"Mobile App UI/UX Design\"\n                - option \"Design Audit & Consulting\"\n            - generic [ref=e650]:\n              - generic [ref=e651]: Target Budget\n              - combobox [ref=e652]:\n                - option \"$3,000 - $5,000\"\n                - option \"$5,000 - $10,000\" [selected]\n                - option \"$10,000 - $25,000\"\n                - option \"$25,000+ (Enterprise)\"\n          - generic [ref=e653]:\n            - generic [ref=e654]: Project Goals & Context *\n            - textbox \"Tell me about your product, timeline, and what you aim to achieve...\" [ref=e655]\n          - button \"Send Proposal / Open Mail\" [ref=e656]\n  - contentinfo [ref=e661]:\n    - generic [ref=e662]:\n      - generic [ref=e663]:\n        - generic [ref=e664]: SAIFUL ISLAM\n        - generic [aria-hidden] [ref=e665]: \302\267\n        - generic [ref=e666]: \302\251 2026. All rights reserved.\n      - generic [ref=e667]:\n        - link \"GitHub\" [ref=e668] [c