      thinking_signature: "\022\335\001\n\332\001\001i\024}\023\003\254aiJ_~\3251\242J{g\250\304A\261I\262\244\270u\201\242!\366\033\367\fx`\024\251\035\203l\177\\\016U\025\027$\376\'\302\253\273F$\247\302\254\254\215(P\277\334\274\216\a\310l\020c\263\025Q)\375\005\222v\336\277\357\353\025ODu}w\006\361c\253@\215\210\f\241\017\303\005\321\325\345\312%\255rE\215\2644\376\226W44\330N\224>9\340(d\001\361?\250\177)L\'\276\000\227\\\227MiO\036M\324\346\264C\244=\026\\\227.\025Q\272zy\307\221\250\341\233$\005\271J\n.{\361\006\376az9\357>\275\335\263\270S=\032\327\315\253n\355\325C\302\355BAQ\"\342\237\330\027 \035\344CBg\020}\277\201\270=:\302\004p"
