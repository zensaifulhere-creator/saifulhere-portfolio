    start_line: 179
    end_line: 209
    content: "  const overlap = (minDist - dist) * 0.5;\n  p1.x -= nx * overlap;\n  p1.y -= ny * overlap;\n  p2.x += nx * overlap;\n  p2.y += ny * overlap;\n\n  // Relative velocity along collision normal\n  const rvx = p2.vx - p1.vx;\n  const rvy = p2.vy - p1.vy;\n  const velAlongNormal = rvx * nx + rvy * ny;\n\n  // Do not resolve impulse if particles are already separating\n  if (velAlongNormal > 0) {\n    return true;\n  }\n\n  const m1 = p1.mass || (p1.radius * p1.radius);\n  const m2 = p2.mass || (p2.radius * p2.radius);\n\n  // Impulse scalar\n  const impulse = (-(1 + restitution) * velAlongNormal) / (1 / m1 + 1 / m2);\n\n  p1.vx -= (impulse / m1) * nx;\n  p1.vy -= (impulse / m1) * ny;\n  p2.vx += (impulse / m2) * nx;\n  p2.vy += (impulse / m2) * ny;\n\n  return true;\n}\n\n"
    num_lines: 210
    num_bytes: 5164
    line_range_bytes: 748
  }
