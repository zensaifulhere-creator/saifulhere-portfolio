  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useRef } from \'react\';\n\ninterface Particle {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  originX: number;\n  originY: number;\n  radius: number;\n  baseAlpha: number;\n  isReactive: boolean; // true = reactive anchor swarm, false = ambient continuous drift\n  driftVx: number;\n  driftVy: number;\n}\n\ninterface AntigravityCanvasProps {\n  motionEnabled: boolean;\n}\n\nexport const AntigravityCanvas: React.FC<AntigravityCanvasProps> = ({ motionEnabled }) => {\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n  const particlesRef = useRef<Particle[]>([]);\n  const mouseRef = useRef<{ x: number | null; y: number | null }>({ x: null, y: null });\n  const animFrameRef = useRef<number | null>(null);\n\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let width = (canvas.width = window.innerWidth);\n    let height = (canvas.height = window.innerHeight);\n\n    const handleResize = () => {\n      if (!canvas) return;\n      width = canvas.width = window.innerWidth;\n      height = canvas.height = window.innerHeight;\n      initScatteredParticles();\n    };\n\n    const initScatteredParticles = () => {\n      // Scale count to viewport size: ~480 on desktop, ~180 on mobile\n      const count = Math.min(Math.floor((width * height) / 2800), 550);\n      const particles: Particle[] = [];\n\n      for (let i = 0; i < count; i++) {\n        const x = Math.random() * width;\n        const y = Math.random() * height;\n        const isReactive = Math.random() < 0.65; // 65% reactive to cursor, 35% ambient drifting\n\n        particles.push({\n          x,\n          y,\n          vx: 0,\n          vy: 0,\n          originX: x,\n          originY: y,\n          radius: isReactive ? 1.0 + Math.random() * 0.8 : 0.8 + Math.random() * 1.4,\n          baseAlpha: isReactive ? 0.14 + Math.random() * 0.12 : 0.08 + Math.random() * 0.2,\n          isReactive,\n          driftVx: (Math.random() - 0.5) * 0.45,\n          driftVy: (Math.random() - 0.5) * 0.45,\n        });\n      }\n\n      particlesRef.current = particles;\n    };\n\n    initScatteredParticles();\n    window.addEventListener(\'resize\', handleResize);\n\n    const handleMouseMove = (e: MouseEvent) => {\n      mouseRef.current = { x: e.clientX, y: e.clientY };\n    };\n\n    const handleTouchMove = (e: TouchEvent) => {\n      if (e.touches.length > 0) {\n        mouseRef.current = { x: e.touches[0].clientX, y: e.touches[0].clientY };\n      }\n    };\n\n    const handleMouseLeave = () => {\n      mouseRef.current = { x: null, y: null };\n    };\n\n    window.addEventListener(\'mousemove\', handleMouseMove, { passive: true });\n    window.addEventListener(\'touchmove\', handleTouchMove, { passive: true });\n    document.addEventListener(\'mouseleave\', handleMouseLeave);\n    window.addEventListener(\'touchend\', handleMouseLeave);\n\n    const render = () => {\n      if (!ctx || !canvas) return;\n\n      ctx.clearRect(0, 0, width, height);\n\n      const particles = particlesRef.current;\n      const mouse = mouseRef.current;\n      const agitatedParticles: Particle[] = [];\n      const repulsionRadius = 185;\n      const repulsionRadiusSq = repulsionRadius * repulsionRadius;\n\n      for (let i = 0; i < particles.length; i++) {\n        const p = particles[i];\n\n        if (motionEnabled) {\n          if (p.isReactive) {\n            // TYPE A: Anchor swarm that springs back to its scattered coordinate\n            const dxOrigin = p.originX - p.x;\n            const dyOrigin = p.originY - p.y;\n            p.vx += dxOrigin * 0.026;\n            p.vy += dyOrigin * 0.026;\n\n            // Repulsed strongly by cursor\n            if (mouse.x !== null && mouse.y !== null) {\n              const dxMouse = p.x - mouse.x;\n              const dyMouse = p.y - mouse.y;\n              const distSq = dxMouse * dxMouse + dyMouse * dyMouse;\n\n              if (distSq < repulsionRadiusSq && distSq > 0.01) {\n                const dist = Math.sqrt(distSq);\n                const force = (1 - dist / repulsionRadius) * 1.4;\n                p.vx += (dxMouse / dist) * force * 4.5;\n                p.vy += (dyMouse / dist) * force * 4.5;\n              }\n            }\n\n            p.vx *= 0.91;\n            p.vy *= 0.91;\n            p.x += p.vx;\n            p.y += p.vy;\n          } else {\n            // TYPE B: Ambient drifting cosmic particle that gently curves in mouse wake\n            p.x += p.driftVx;\n            p.y += p.driftVy;\n\n            // Gentle curve when cursor approaches\n            if (mouse.x !== null && mouse.y !== null) {\n              const dxMouse = p.x - mouse.x;\n              const dyMouse = p.y - mouse.y;\n              const distSq = dxMouse * dxMouse + dyMouse * dyMouse;\n\n              if (distSq < repulsionRadiusSq && distSq > 0.01) {\n                const dist = Math.sqrt(distSq);\n                const wakeForce = (1 - dist / repulsionRadius) * 0.4;\n                p.x += (dxMouse / dist) * wakeForce * 1.8;\n                p.y += (dyMouse / dist) * wakeForce * 1.8;\n              }\n            }\n\n            // Screen boundary wrapping\n            if (p.x < -10) p.x = width + 10;\n            else if (p.x > width + 10) p.x = -10;\n            if (p.y < -10) p.y = height + 10;\n            else if (p.y > height + 10) p.y = -10;\n          }\n        }\n\n        // Visual rendering based on agitation & particle type\n        const dx = p.x - p.originX;\n        const dy = p.y - p.originY;\n        const displacement = Math.sqrt(dx * dx + dy * dy);\n        const intensity = p.isReactive ? Math.min(displacement / 24, 1) : 0;\n\n        if (intensity > 0.15) {\n          agitatedParticles.push(p);\n          // Crimson glowing core when affected by cursor\n          ctx.fillStyle = `rgba(227, 43, 60, ${0.4 + intensity * 0.55})`;\n          ctx.beginPath();\n          ctx.arc(p.x, p.y, p.radius + intensity * 1.6, 0, Math.PI * 2);\n          ctx.fill();\n        } else {\n          // Subtle warm star points\n          ctx.fillStyle = p.isReactive\n            ? `rgba(242, 239, 235, ${p.baseAlpha})`\n            : `rgba(227, 43, 60, ${p.baseAlpha * 0.75})`;\n          ctx.beginPath();\n          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);\n          ctx.fill();\n        }\n      }\n\n      // Draw luminous web filaments connecting agitated particles near cursor\n      if (agitatedParticles.length > 1 && mouse.x !== null && mouse.y !== null) {\n        ctx.lineWidth = 0.65;\n        for (let a = 0; a < agitatedParticles.length; a++) {\n          for (let b = a + 1; b < Math.min(a + 6, agitatedParticles.length); b++) {\n            const pA = agitatedParticles[a];\n            const pB = agitatedParticles[b];\n            const distSq = (pA.x - pB.x) ** 2 + (pA.y - pB.y) ** 2;\n\n            if (distSq < 3600) {\n              const alpha = (1 - Math.sqrt(distSq) / 60) * 0.35;\n              ctx.strokeStyle = `rgba(227, 43, 60, ${alpha})`;\n              ctx.beginPath();\n              ctx.moveTo(pA.x, pA.y);\n              ctx.lineTo(pB.x, pB.y);\n              ctx.stroke();\n            }\n          }\n        }\n      }\n\n      if (motionEnabled) {\n        animFrameRef.current = requestAnimationFrame(render);\n      }\n    };\n\n    render();\n\n    return () => {\n      window.removeEventListener(\'resize\', handleResize);\n      window.removeEventListener(\'mousemove\', handleMouseMove);\n      window.removeEventListener(\'touchmove\', handleTouchMove);\n      document.removeEventListener(\'mouseleave\', handleMouseLeave);\n      window.removeEventListener(\'touchend\', handleMouseLeave);\n      if (animFrameRef.current) {\n        cancelAnimationFrame(animFrameRef.current);\n      }\n    };\n  }, [motionEnabled]);\n\n  return (\n    <canvas\n      ref={canvasRef}\n      className=\"fixed inset-0 pointer-events-none z-0 opacity-90 transition-opacity duration-500\"\n      aria-hidden=\"true\"\n    />\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AntigravityCanvas.tsx"
        }
        overwrite: true
      }
    }
