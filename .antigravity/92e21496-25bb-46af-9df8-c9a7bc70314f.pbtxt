  view_file {
    absolute_path_uri: "file:///src/components/Footer.tsx"
    end_line: 80
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { ArrowUp } from \'lucide-react\';\nimport { siteConfig } from \'../config/site\';\n\nexport const Footer: React.FC = () => {\n  const { identity, socialLinks } = siteConfig;\n\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer className=\"py-12 border-t border-white/[0.08] bg-[#070709] text-xs font-mono text-[#a09c9a]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6\">\n        \n        {/* Wordmark & Copyright */}\n        <div className=\"flex items-center gap-3\">\n          <span className=\"font-display text-lg text-white tracking-wider\">\n            {identity.fullName.toUpperCase()}\n          </span>\n          <span aria-hidden=\"true\" className=\"text-white/20\">\302\267</span>\n          <span>\302\251 2026. All rights reserved.</span>\n        </div>\n\n        {/* Social Links */}\n        <div className=\"flex items-center gap-6\">\n          <a\n            href={socialLinks.github}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"hover:text-white transition-colors\"\n          >\n            GitHub\n          </a>\n          <a\n            href={socialLinks.linkedin}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"hover:text-white transition-colors\"\n          >\n            LinkedIn\n          </a>\n          <a\n            href={socialLinks.dribbble}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"hover:text-white transition-colors\"\n          >\n            Dribbble\n          </a>\n          <a\n            href={socialLinks.behance}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"hover:text-white transition-colors\"\n          >\n            Behance\n          </a>\n        </div>\n\n        {/* Back to top button */}\n        <button\n          onClick={scrollToTop}\n          type=\"button\"\n          className=\"flex items-center gap-1.5 px-3 py-1.5 rounded border border-white/10 hover:border-white/30 text-white bg-white/[0.02] hover:bg-white/[0.08] transition-all\"\n          aria-label=\"Scroll back to top\"\n        >\n          <span>Top</span>\n          <ArrowUp className=\"w-3.5 h-3.5 text-[#e32b3c]\" />\n        </button>\n\n      </div>\n    </footer>\n  );\n};\n"
    num_lines: 81
    num_bytes: 2439
    line_range_bytes: 2439
  }
}
