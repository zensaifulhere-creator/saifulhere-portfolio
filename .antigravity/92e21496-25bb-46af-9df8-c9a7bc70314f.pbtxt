    content: "          onMouseEnter={() => setIsPlaying(false)}\n          onMouseLeave={() => setIsPlaying(true)}\n          onTouchStart={handleTouchStart}\n          onTouchEnd={handleTouchEnd}\n        >\n          {/* Main Testimonial Spotlight Card with Layered Frosted Glass & Blur Effects */}\n          <div className=\"relative rounded-none border border-white/[0.09] bg-[#121214]/60 backdrop-blur-2xl overflow-hidden shadow-2xl transition-all duration-300\">\n            \n            {/* Top Crimson Accent Beam */}\n            <div className=\"absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#e32b3c] to-transparent opacity-80\" />\n            \n            {/* Ambient Internal Glow */}\n            <div className=\"absolute -top-20 -right-20 w-80 h-80 bg-[#e32b3c]/[0.08] rounded-full blur-[80px] pointer-events-none\" />\n\n            <div className=\"p-6 sm:p-10 md:p-14 relative z-10\">\n              \n              {/* Card Meta Bar */}\n              <div className=\"flex flex-wrap items-center justify-between gap-4 pb-8 mb-8 border-b border-white/[0.07]\">\n                \n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 bg-[#e32b3c]/10 border border-[#e32b3c]/30 flex items-center justify-center text-[#e32b3c]\">\n                    <Quote className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-1.5\">\n                      {[...Array(current.rating)].map((_, i) => (\n                        <Star key={i} className=\"w-3.5 h-3.5 text-[#e32b3c] fill-[#e32b3c]\" />\n                      ))}\n                    </div>\n                    <span className=\"text-[10px] font-mono uppercase tracking-wider text-[#a09c9a]\">\n                      Verified Endorsement \302\267 {current.year}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Impact Metric Chip */}\n                <div className=\"flex items-center gap-2 px-3.5 py-1.5 bg-[#e32b3c]/10 border border-[#e32b3c]/30 font-mono text-xs text-white\">\n                  <TrendingUp className=\"w-3.5 h-3.5 text-[#e32b3c]\" />\n                  <span className=\"text-[#a09c9a] uppercase text-[10px]\">Impact:</span>\n                  <span className=\"font-semibold text-[#f2efeb]\">{current.impact}</span>\n                </div>\n\n              </div>\n\n              {/* Animated Testimonial Text & Info */}\n              <div className=\"min-h-[220px] sm:min-h-[200px] flex flex-col justify-between\">\n                <AnimatePresence mode=\"wait\">\n                  <motion.div\n                    key={current.id}\n                    initial={{ opacity: 0, y: direction * 15 }}\n                    animate={{ opacity: 1, y: 0 }}\n                    exit={{ opacity: 0, y: -direction * 15 }}\n                    transition={{ duration: 0.35, ease: [0.16, 1, 0.3, 1] }}\n                    className=\"space-y-8\"\n                  >\n                    {/* The Quote */}\n                    <blockquote className=\"font-sans text-xl sm:text-2xl md:text-3xl text-white font-light leading-relaxed tracking-tight\">\n                      &ldquo;{current.quote}&rdquo;\n                    </blockquote>\n\n                    {/* Author, Deliverable & Organization */}\n                    <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-6 pt-6 border-t border-white/[0.06]\">\n                      \n                      <div className=\"flex items-center gap-4\">\n                        {/* Monogram Square Avatar */}\n                        <div className=\"w-12 h-12 bg-white/[0.04] border border-white/15 flex items-center justify-center font-mono font-bold text-white text-base tracking-wider shrink-0 relative\">\n                          <span>{current.avatarInitials}</span>\n                          <span className=\"absolute bottom-0 right-0 w-2 h-2 bg-[#e32b3c]\" />\n                        </div>\n\n                        <div>\n                          <div className=\"flex items-center gap-2\">\n                            <h4 className=\"font-display text-xl text-white tracking-wide\">\n                              {current.author}\n                            </h4>\n                            {current.verified && (\n                              <span title=\"Verified Client\">\n                                <CheckCircle2 className=\"w-4 h-4 text-[#e32b3c]\" />\n                              </span>\n                            )}\n                          </div>\n                          <p className=\"text-xs sm:text-sm text-[#a09c9a] font-sans\">\n                            {current.role} <span className=\"text-white/30\">\302\267</span>{\' \'}\n                            <span className=\"text-white font-medium\">{current.company}</span>\n                          </p>\n                        </div>\n                      </div>\n\n                      {/* Deliverable Project Tag */}\n                      <div className=\"flex items-center gap-2 text-xs font-mono text-[#a09c9a] bg-white/[0.02] border border-white/10 px-3 py-2 self-start sm:self-auto\">\n                        <Briefcase className=\"w-3.5 h-3.5 text-[#e32b3c]\" />\n                        <span className=\"text-white/50 uppercase text-[10px]\">Delivered:</span>\n                        <span className=\"text-white truncate max-w-[220px] sm:max-w-none\">\n                          {current.project}\n                        </span>\n                      </div>\n\n                    </div>\n                  </motion.div>\n                </AnimatePresence>\n              </div>\n\n            </div>\n\n            {/* Bottom Interactive Control Strip */}\n            <div className=\"border-t border-white/[0.08] bg-black/40 px-6 sm:px-10 py-4 flex flex-col sm:flex-row items-center justify-between gap-4\">\n              \n              {/* Slide Counter & Progress */}\n              <div className=\"flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-start\">\n                <span className=\"font-mono text-xs text-white tracking-widest\">\n                  <span className=\"text-[#e32b3c]\">0{activeIndex + 1}</span>\n                  <span className=\"text-white/30\"> / 0{total}</span>\n                </span>\n\n                <div className=\"w-28 sm:w-36 h-1 bg-white/10 overflow-hidden\">\n                  <div\n                    className=\"h-full bg-[#e32b3c] transition-all duration-300\"\n                    style={{ width: `${progress}%` }}\n                  />\n                </div>\n\n                {/* Auto Play / Pause Toggle */}\n                <button\n                  type=\"button\"\n                  onClick={() => setIsPlaying((p) => !p)}\n                  className=\"flex items-center gap-1.5 text-[10px] font-mono uppercase text-[#a09c9a] hover:text-white transition-colors cursor-pointer px-2 py-1 bg-white/[0.02] border border-white/10\"\n                  title={isPlaying ? \'Pause auto-rotation\' : \'Resume auto-rotation\'}\n                >\n                  {isPlaying ? (\n                    <>\n                      <Pause className=\"w-3 h-3 text-[#e32b3c]\" />\n                      <span>Auto [On]</span>\n                    </>\n                  ) : (\n                    <>\n                      <Play className=\"w-3 h-3 text-white/50\" />\n                      <span>Auto [Paused]</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              {/* Prev / Next Sharp Rectangular Navigation Buttons */}\n              <div className=\"flex items-center gap-2 w-full sm:w-auto justify-end\">\n                <button\n                  type=\"button\"\n                  onClick={handlePrev}\n                  aria-label=\"Previous testimonial\"\n                  className=\"px-3.5 py-2 bg-white/[0.03] hover:bg-[#e32b3c] hover:text-white border border-white/10 text-white font-mono text-xs transition-all cursor-pointer flex items-center gap-1 active:scale-95\"\n                >\n                  <ChevronLeft className=\"w-4 h-4\" />\n                  <span className=\"hidden sm:inline\">PREV</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={handleNext}\n                  aria-label=\"Next testimonial\"\n                  className=\"px-3.5 py-2 bg-white/[0.03] hover:bg-[#e32b3c] hover:text-white border border-white/10 text-white font-mono text-xs transition-all cursor-pointer flex items-center gap-1 active:scale-95\"\n                >\n                  <span className=\"hidden sm:inline\">NEXT</span>"
