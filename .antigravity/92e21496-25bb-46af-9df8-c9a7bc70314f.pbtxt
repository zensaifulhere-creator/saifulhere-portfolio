  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { Check, ArrowRight, ShieldCheck, Zap, Sparkles } from \'lucide-react\';\nimport { siteConfig } from \'../config/site\';\n\ninterface PricingSectionProps {\n  onSelectTier: (serviceName: string, budgetValue: string) => void;\n}\n\nexport const PricingSection: React.FC<PricingSectionProps> = ({ onSelectTier }) => {\n  const { pricingTiers } = siteConfig;\n\n  return (\n    <section id=\"pricing\" className=\"py-20 md:py-28 border-b border-white/[0.08] relative\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6\">\n          <div>\n            <div className=\"flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[#e32b3c] mb-2\">\n              <span>03 / Investment</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>Engagement Models</span>\n            </div>\n            <h2 className=\"font-display text-4xl sm:text-5xl lg:text-6xl text-white uppercase tracking-tight\">\n              TRANSPARENT PRICING & SCOPE\n            </h2>\n          </div>\n\n          <p className=\"text-sm text-[#a09c9a] max-w-md font-sans\">\n            Predictable sprints and dedicated retainers. No surprise invoices, no bloated agency overhead\342\200\224just direct senior design and frontend execution.\n          </p>\n        </div>\n\n        {/* Pricing Cards Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch\">\n          {pricingTiers.map((tier) => (\n            <div\n              key={tier.id}\n              className={`rounded-2xl p-8 flex flex-col justify-between transition-all duration-300 relative ${\n                tier.featured\n                  ? \'bg-[#151518] border-2 border-[#e32b3c] shadow-2xl shadow-[#e32b3c]/10 lg:-translate-y-2\'\n                  : \'bg-[#121214] border border-white/[0.08] hover:border-white/20\'\n              }`}\n            >\n              {/* Highlight ribbon for featured tier */}\n              {tier.featured && (\n                <div className=\"absolute -top-3.5 left-8 px-3 py-1 rounded bg-[#e32b3c] text-white text-[10px] font-mono uppercase tracking-widest font-bold shadow-md flex items-center gap-1.5\">\n                  <Sparkles className=\"w-3 h-3\" />\n                  <span>Flagship / Most Requested</span>\n                </div>\n              )}\n\n              <div className=\"space-y-6\">\n                {/* Header */}\n                <div className=\"space-y-2 border-b border-white/[0.06] pb-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-xs font-mono uppercase text-[#a09c9a] tracking-wider\">\n                      {tier.period}\n                    </span>\n                  </div>\n\n                  <h3 className=\"font-display text-2xl text-white tracking-wide\">\n                    {tier.title}\n                  </h3>\n\n                  <div className=\"flex items-baseline gap-2 pt-2\">\n                    <span className=\"font-display text-4xl sm:text-5xl text-white tabular-nums\">\n                      {tier.price}\n                    </span>\n                    <span className=\"text-xs font-mono text-[#a09c9a]\">\n                      {tier.id === \'design-engineering-retainer\' ? \'/ month\' : \'flat fee\'}\n                    </span>\n                  </div>\n\n                  <p className=\"text-xs text-[#a09c9a] font-sans pt-1 leading-relaxed\">\n                    {tier.description}\n                  </p>\n                </div>\n\n                {/* Target Audience Note */}\n                <div className=\"p-3 rounded-lg bg-white/[0.02] border border-white/[0.06] text-xs text-[#f2efeb]/80 font-sans\">\n                  <span className=\"text-[#e32b3c] font-semibold\">Fit: </span>\n                  {tier.targetFor}\n                </div>\n\n                {/* Deliverables Checklist */}\n                <div className=\"space-y-3 pt-2\">\n                  <span className=\"text-[11px] font-mono uppercase text-white/50 tracking-wider block\">\n                    What You Receive:\n                  </span>\n                  <ul className=\"space-y-2.5\">\n                    {tier.deliverables.map((item, idx) => (\n                      <li key={idx} className=\"flex items-start gap-2.5 text-xs text-[#f2efeb]\">\n                        <Check className=\"w-4 h-4 text-[#e32b3c] shrink-0 mt-0.5\" />\n                        <span className=\"font-sans leading-relaxed\">{item}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              </div>\n\n              {/* Action Button */}\n              <div className=\"pt-8 mt-6 border-t border-white/[0.06]\">\n                <button\n                  onClick={() => onSelectTier(tier.serviceName, tier.budgetValue)}\n                  type=\"button\"\n                  className={`w-full py-3.5 px-6 rounded-lg font-semibold text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-2 active:scale-95 ${\n                    tier.featured\n                      ? \'bg-[#e32b3c] hover:bg-[#c92232] text-white shadow-lg shadow-[#e32b3c]/20\'\n                      : \'bg-white/10 hover:bg-white/20 text-white\'\n                  }`}\n                >\n                  <span>{tier.ctaLabel}</span>\n                  <ArrowRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n            </div>\n          ))}\n        </div>\n\n        {/* Guarantees & Values Strip */}\n        <div className=\"p-6 sm:p-8 rounded-2xl bg-[#0e0e11] border border-white/[0.08] grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div className=\"flex items-start gap-3\">\n            <ShieldCheck className=\"w-5 h-5 text-[#e32b3c] shrink-0 mt-0.5\" />\n            <div>\n              <h4 className=\"text-xs font-mono uppercase text-white font-semibold tracking-wider\">\n                100% IP & Code Ownership\n              </h4>\n              <p className=\"text-xs text-[#a09c9a] mt-1 font-sans\">\n                Full copyright, Figma files, tokens, and React repositories transferred to your team with zero license encumbrances.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-start gap-3\">\n            <Zap className=\"w-5 h-5 text-[#e32b3c] shrink-0 mt-0.5\" />\n            <div>\n              <h4 className=\"text-xs font-mono uppercase text-white font-semibold tracking-wider\">\n                Direct Principal Access\n              </h4>\n              <p className=\"text-xs text-[#a09c9a] mt-1 font-sans\">\n                You work directly with Saiful\342\200\224no account managers, junior delegates, or middle layers between design and code.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-start gap-3\">\n            <Sparkles className=\"w-5 h-5 text-[#e32b3c] shrink-0 mt-0.5\" />\n            <div>\n              <h4 className=\"text-xs font-mono uppercase text-white font-semibold tracking-wider\">\n                Continuous Milestone Demos\n              </h4>\n              <p className=\"text-xs text-[#a09c9a] mt-1 font-sans\">\n                Weekly interactive sandbox links and video async recaps ensure complete alignment before final handoff.\n              </p>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/PricingSection.tsx"
        }
        overwrite: true
      }
    }
