    end_line: 229
    content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState } from \'react\';\nimport { Sparkles, Menu, X, ArrowUpRight } from \'lucide-react\';\n\ninterface HeaderProps {\n  motionEnabled: boolean;\n  onToggleMotion: () => void;\n  onOpenContact: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({\n  motionEnabled,\n  onToggleMotion,\n  onOpenContact,\n}) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  return (\n    <header className=\"sticky top-0 z-40 w-full backdrop-blur-md bg-[#090909]/80 border-b border-white/[0.07] transition-all\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-6\">\n        {/* Zone 1: Brand Wordmark */}\n        <a\n          href=\"#top\"\n          className=\"group flex items-center gap-2 whitespace-nowrap shrink-0 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#e32b3c] rounded\"\n        >\n          <span className=\"font-display text-2xl tracking-wider text-white group-hover:text-[#e32b3c] transition-colors\">\n            SAIFUL ISLAM\n          </span>\n          <span className=\"text-[10px] tracking-widest text-[#a09c9a] uppercase font-mono hidden sm:inline-block\">\n            / UI\302\267UX ENG\n          </span>\n        </a>\n\n        {/* Zone 2: 4-5 Single-line Navigation Links */}\n        <nav\n          aria-label=\"Main Navigation\"\n          className=\"hidden md:flex items-center gap-8 text-sm font-medium text-[#a09c9a]\"\n        >\n          <a\n            href=\"#projects\"\n            className=\"hover:text-white transition-colors py-1 relative hover:after:w-full after:w-0 after:h-[1px] after:bg-[#e32b3c] after:absolute after:bottom-0 after:left-0 after:transition-all\"\n          >\n            Works\n          </a>\n          <a\n            href=\"#process\"\n            className=\"hover:text-white transition-colors py-1 relative hover:after:w-full after:w-0 after:h-[1px] after:bg-[#e32b3c] after:absolute after:bottom-0 after:left-0 after:transition-all\"\n          >\n            Process\n          </a>\n          <a\n            href=\"#pricing\"\n            className=\"hover:text-white transition-colors py-1 relative hover:after:w-full after:w-0 after:h-[1px] after:bg-[#e32b3c] after:absolute after:bottom-0 after:left-0 after:transition-all\"\n          >\n            Pricing\n          </a>\n          <a\n            href=\"#experience\"\n            className=\"hover:text-white transition-colors py-1 relative hover:after:w-full after:w-0 after:h-[1px] after:bg-[#e32b3c] after:absolute after:bottom-0 after:left-0 after:transition-all\"\n          >\n            Experience\n          </a>\n          <a\n            href=\"#about\"\n            className=\"hover:text-white transition-colors py-1 relative hover:after:w-full after:w-0 after:h-[1px] after:bg-[#e32b3c] after:absolute after:bottom-0 after:left-0 after:transition-all\"\n          >\n            About\n          </a>\n          <a\n            href=\"#contact\"\n            className=\"hover:text-white transition-colors py-1 relative hover:after:w-full after:w-0 after:h-[1px] after:bg-[#e32b3c] after:absolute after:bottom-0 after:left-0 after:transition-all\"\n          >\n            Contact\n          </a>\n        </nav>\n\n        {/* Zone 3: Primary Action & Controls */}\n        <div className=\"flex items-center gap-3 shrink-0\">\n          {/* Prominent Stylized Motion Toggle Switch */}\n          <button\n            role=\"switch\"\n            aria-checked={motionEnabled}\n            onClick={onToggleMotion}\n            type=\"button\"\n            title={\n              motionEnabled\n                ? \'Interactive particle swarm is active. Click to pause.\'\n                : \'Interactive particle swarm is paused. Click to activate.\'\n            }\n            aria-label={`Particle swarm motion is ${motionEnabled ? \'Active\' : \'Paused\'}. Click to toggle.`}\n            className={`group relative flex items-center gap-2.5 px-3 py-1.5 rounded-full border transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#e32b3c] ${\n              motionEnabled\n                ? \'bg-[#180e10] border-[#e32b3c]/70 shadow-[0_0_16px_rgba(227,43,60,0.25)] hover:border-[#e32b3c]\'\n                : \'bg-[#121214] border-white/15 hover:border-white/30 text-[#a09c9a]\'\n            }`}\n          >\n            {/* Label and Status Badge */}\n            <div className=\"flex items-center gap-1.5 text-[11px] font-mono tracking-wider\">\n              <Sparkles\n                className={`w-3.5 h-3.5 transition-colors ${\n                  motionEnabled ? \'text-[#e32b3c]\' : \'text-[#a09c9a]\'\n                }`}\n              />\n              <span className={`font-semibold hidden sm:inline ${motionEnabled ? \'text-white\' : \'text-[#a09c9a]\'}`}>\n                SWARM\n              </span>\n              <span\n                className={`px-1.5 py-0.5 rounded text-[9px] font-mono uppercase tracking-widest font-bold transition-all ${\n                  motionEnabled\n                    ? \'bg-[#e32b3c]/20 text-[#e32b3c] border border-[#e32b3c]/40\'\n                    : \'bg-white/5 text-[#a09c9a] border border-white/10\'\n                }`}\n              >\n                {motionEnabled ? \'ON\' : \'PAUSED\'}\n              </span>\n            </div>\n\n            {/* Stylized Slider Pill & Thumb */}\n            <div\n              className={`relative w-8 h-4.5 rounded-full p-0.5 transition-colors duration-300 ${\n                motionEnabled ? \'bg-[#e32b3c]/30\' : \'bg-[#232328]\'\n              }`}\n            >\n              <div\n                className={`w-3.5 h-3.5 rounded-full flex items-center justify-center transition-all duration-300 shadow-sm ${\n                  motionEnabled\n                    ? \'translate-x-3.5 bg-[#e32b3c] text-white shadow-[#e32b3c]/60\'\n                    : \'translate-x-0 bg-[#52525b] text-white/40\'\n                }`}\n              >\n                {motionEnabled ? (\n                  <span className=\"w-1 h-1 rounded-full bg-white animate-pulse\" />\n                ) : (\n                  <span className=\"w-1.5 h-0.5 rounded-full bg-white/50\" />\n                )}\n              </div>\n            </div>\n          </button>\n\n          {/* Primary CTA */}\n          <button\n            onClick={onOpenContact}\n            type=\"button\"\n            className=\"hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white bg-[#e32b3c] hover:bg-[#c92232] rounded transition-all shadow-sm active:scale-95\"\n          >\n            <span>Let\'s Talk</span>\n            <ArrowUpRight className=\"w-3.5 h-3.5\" />\n          </button>\n\n          {/* Mobile hamburger */}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            type=\"button\"\n            className=\"md:hidden p-2 text-[#a09c9a] hover:text-white focus:outline-none\"\n            aria-label=\"Toggle menu\"\n            aria-expanded={mobileMenuOpen}\n          >\n            {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile navigation drawer */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden border-t border-white/[0.08] bg-[#0c0c0e] px-4 py-6 space-y-4\">\n          <nav className=\"flex flex-col space-y-3 text-base\">\n            <a\n              href=\"#projects\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"text-[#a09c9a] hover:text-white py-1 transition-colors\"\n            >\n              Selected Works\n            </a>\n            <a\n              href=\"#process\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"text-[#a09c9a] hover:text-white py-1 transition-colors\"\n            >\n              Design Process\n            </a>\n            <a\n              href=\"#pricing\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"text-[#a09c9a] hover:text-white py-1 transition-colors\"\n            >\n              Pricing & Sprints\n            </a>\n            <a\n              href=\"#experience\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"text-[#a09c9a] hover:text-white py-1 transition-colors\"\n            >\n              Career Experience\n            </a>\n            <a\n              href=\"#about\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"text-[#a09c9a] hover:text-white py-1 transition-colors\"\n            >\n              About & Philosophy\n            </a>\n            <a\n              href=\"#contact\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"text-[#a09c9a] hover:text-white py-1 transition-colors\"\n            >\n              Contact Me\n            </a>\n          </nav>\n          <div className=\"pt-4 border-t border-white/[0.08] flex items-center justify-between\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenContact();\n              }}\n              className=\"w-full py-2.5 px-4 text-center text-xs font-semibold uppercase tracking-wider text-white bg-[#e32b3c] hover:bg-[#c92232] rounded transition-all\"\n            >\n              Start a Project\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    num_lines: 230
    num_bytes: 9352
    line_range_bytes: 9352
  }
}
