              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'I craft enterprise design systems, fluid micro-interactions, and high-fidelity interactive prototypes. Balancing brutalist typographic grit with pixel-perfect frontend engineering.\',"
