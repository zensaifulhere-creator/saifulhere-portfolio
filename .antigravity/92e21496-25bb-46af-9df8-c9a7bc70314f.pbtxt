            }
            lines {
              text: "      number: \'03\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      title: \'Design Tokens & Multi-Theme Systems\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      description:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Authoring mathematical color scales, fluid typographic ladders, and semantic elevation tokens synchronizable across Figma and code.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      deliverables: [\'Figma variables library\', \'W3C token exports\', \'Accessibility matrix\'],"
