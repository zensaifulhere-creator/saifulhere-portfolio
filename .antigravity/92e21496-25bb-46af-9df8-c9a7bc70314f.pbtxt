  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect, useRef, useCallback } from \'react\';\nimport {\n  Quote,\n  ChevronLeft,\n  ChevronRight,\n  Star,\n  CheckCircle2,\n  Pause,\n  Play,\n  Briefcase,\n  TrendingUp,\n} from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { siteConfig } from \'../config/site\';\nimport {\n  getNextSlideIndex,\n  getPrevSlideIndex,\n  calculateProgressPercentage,\n} from \'../utils/portfolio\';\n\ninterface TestimonialsSectionProps {\n  onOpenContact?: () => void;\n}\n\nexport const TestimonialsSection: React.FC<TestimonialsSectionProps> = ({\n  onOpenContact,\n}) => {\n  const { testimonials } = siteConfig;\n  const [activeIndex, setActiveIndex] = useState(0);\n  const [isPlaying, setIsPlaying] = useState(true);\n  const [direction, setDirection] = useState<1 | -1>(1);\n  const [touchStartX, setTouchStartX] = useState<number | null>(null);\n\n  const total = testimonials.length;\n  const current = testimonials[activeIndex] || testimonials[0];\n\n  const handleNext = useCallback(() => {\n    setDirection(1);\n    setActiveIndex((prev) => getNextSlideIndex(prev, total));\n  }, [total]);\n\n  const handlePrev = useCallback(() => {\n    setDirection(-1);\n    setActiveIndex((prev) => getPrevSlideIndex(prev, total));\n  }, [total]);\n\n  const handleSelect = (index: number) => {\n    setDirection(index > activeIndex ? 1 : -1);\n    setActiveIndex(index);\n  };\n\n  // Auto-play timer (pauses on user interaction / hover)\n  useEffect(() => {\n    if (!isPlaying || total <= 1) return;\n\n    const interval = setInterval(() => {\n      handleNext();\n    }, 7000);\n\n    return () => clearInterval(interval);\n  }, [isPlaying, total, handleNext]);\n\n  // Keyboard navigation\n  const handleKeyDown = (e: React.KeyboardEvent) => {\n    if (e.key === \'ArrowLeft\') {\n      handlePrev();\n    } else if (e.key === \'ArrowRight\') {\n      handleNext();\n    }\n  };\n\n  // Touch swipe support for mobile\n  const handleTouchStart = (e: React.TouchEvent) => {\n    setTouchStartX(e.touches[0].clientX);\n  };\n\n  const handleTouchEnd = (e: React.TouchEvent) => {\n    if (touchStartX === null) return;\n    const diff = touchStartX - e.changedTouches[0].clientX;\n    if (diff > 50) {\n      handleNext();\n    } else if (diff < -50) {\n      handlePrev();\n    }\n    setTouchStartX(null);\n  };\n\n  const progress = calculateProgressPercentage(activeIndex, total);\n\n  return (\n    <section\n      id=\"testimonials\"\n      tabIndex={0}\n      onKeyDown={handleKeyDown}\n      className=\"py-24 sm:py-32 border-t border-white/[0.08] relative overflow-hidden bg-[#09090b] focus:outline-none\"\n      aria-label=\"Client Testimonials and Endorsements\"\n    >\n      {/* Cinematic Noir Blur-Effect Background Orbs */}\n      <div\n        aria-hidden=\"true\"\n        className=\"absolute top-1/4 -left-32 w-96 h-96 bg-[#e32b3c]/10 rounded-full blur-[130px] pointer-events-none\"\n      />\n      <div\n        aria-hidden=\"true\"\n        className=\"absolute bottom-10 -right-24 w-[450px] h-[450px] bg-white/[0.03] rounded-full blur-[140px] pointer-events-none\"\n      />\n      <div\n        aria-hidden=\"true\"\n        className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-[#e32b3c]/[0.03] rounded-full blur-[160px] pointer-events-none\"\n      />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16 border-b border-white/[0.08] pb-8\">\n          <div>\n            <div className=\"flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[#e32b3c] mb-3\">\n              <span className=\"w-1.5 h-1.5 bg-[#e32b3c]\" />\n              <span>04 / Endorsements</span>\n              <span className=\"text-white/20\">\302\267</span>\n              <span className=\"text-white/60\">Client Proof</span>\n            </div>\n            <h2 className=\"font-display text-4xl sm:text-5xl md:text-6xl text-white tracking-tight\">\n              WHAT LEADERS SHIP <span className=\"text-[#e32b3c]\">WITH SAIFUL</span>\n            </h2>\n          </div>\n          <p className=\"text-sm sm:text-base text-[#a09c9a] max-w-md font-sans leading-relaxed\">\n            Direct feedback from product leads, VPs of design, and engineering directors who partnered on scalable design systems and interactive prototypes.\n          </p>\n        </div>\n\n        {/* Carousel Main Container */}\n        <div\n          className=\"space-y-8\"\n          onMouseEnter={() => setIsPlaying(false)}\n          onMouseLeave={() => setIsPlaying(true)}\n          onTouchStart={handleTouchStart}\n          onTouchEnd={handleTouchEnd}\n        >\n          {/* Main Testimonial Spotlight Card with Layered Frosted Glass & Blur Effects */}\n          <div className=\"relative rounded-none border border-white/[0.09] bg-[#121214]/60 backdrop-blur-2xl overflow-hidden shadow-2xl transition-all duration-300\">\n            \n            {/* Top Crimson Accent Beam */}\n            <div className=\"absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#e32b3c] to-transparent opacity-80\" />\n            \n            {/* Ambient Internal Glow */}\n            <div className=\"absolute -top-20 -right-20 w-80 h-80 bg-[#e32b3c]/[0.08] rounded-full blur-[80px] pointer-events-none\" />\n\n            <div className=\"p-6 sm:p-10 md:p-14 relative z-10\">\n              \n              {/* Card Meta Bar */}\n              <div className=\"flex flex-wrap items-center justify-between gap-4 pb-8 mb-8 border-b border-white/[0.07]\">\n                \n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 bg-[#e32b3c]/10 border border-[#e32b3c]/30 flex items-center justify-center text-[#e32b3c]\">\n                    <Quote className=\"w-5 h-5\" />\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-1.5\">\n                      {[...Array(current.rating)].map((_, i) => (\n                        <Star key={i} className=\"w-3.5 h-3.5 text-[#e32b3c] fill-[#e32b3c]\" />\n                      ))}\n                    </div>\n                    <span className=\"text-[10px] font-mono uppercase tracking-wider text-[#a09c9a]\">\n                      Verified Endorsement \302\267 {current.year}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Impact Metric Chip */}\n                <div className=\"flex items-center gap-2 px-3.5 py-1.5 bg-[#e32b3c]/10 border border-[#e32b3c]/30 font-mono text-xs text-white\">\n                  <TrendingUp className=\"w-3.5 h-3.5 text-[#e32b3c]\" />\n                  <span className=\"text-[#a09c9a] uppercase text-[10px]\">Impact:</span>\n                  <span className=\"font-semibold text-[#f2efeb]\">{current.impact}</span>\n                </div>\n\n              </div>\n\n              {/* Animated Testimonial Text & Info */}\n              <div className=\"min-h-[220px] sm:min-h-[200px] flex flex-col justify-between\">\n                <AnimatePresence mode=\"wait\">\n                  <motion.div\n                    key={current.id}\n                    initial={{ opacity: 0, y: direction * 15 }}\n                    animate={{ opacity: 1, y: 0 }}\n                    exit={{ opacity: 0, y: -direction * 15 }}\n                    transition={{ duration: 0.35, ease: [0.16, 1, 0.3, 1] }}\n                    className=\"space-y-8\"\n                  >\n                    {/* The Quote */}\n                    <blockquote className=\"font-sans text-xl sm:text-2xl md:text-3xl text-white font-light leading-relaxed tracking-tight\">\n                      &ldquo;{current.quote}&rdquo;\n                    </blockquote>\n\n                    {/* Author, Deliverable & Organization */}\n                    <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-6 pt-6 border-t border-white/[0.06]\">\n                      \n                      <div className=\"flex items-center gap-4\">\n                        {/* Monogram Square Avatar */}\n                        <div className=\"w-12 h-12 bg-white/[0.04] border border-white/15 flex items-center justify-center font-mono font-bold text-white text-base tracking-wider shrink-0 relative\">\n                          <span>{current.avatarInitials}</span>\n                          <span className=\"absolute bottom-0 right-0 w-2 h-2 bg-[#e32b3c]\" />\n                        </div>\n\n                        <div>\n                          <div className=\"flex items-center gap-2\">\n                            <h4 className=\"font-display text-xl text-white tracking-wide\">\n                              {current.author}\n                            </h4>\n                            {current.verified && (\n                              <CheckCircle2\n                                className=\"w-4 h-4 text-[#e32b3c]\"\n                                title=\"Verified Client\"\n                              />\n                            )}\n                          </div>\n                          <p className=\"text-xs sm:text-sm text-[#a09c9a] font-sans\">\n                            {current.role} <span className=\"text-white/30\">\302\267</span>{\' \'}\n                            <span className=\"text-white font-medium\">{current.company}</span>\n                          </p>\n                        </div>\n                      </div>\n\n                      {/* Deliverable Project Tag */}\n                      <div className=\"flex items-center gap-2 text-xs font-mono text-[#a09c9a] bg-white/[0.02] border border-white/10 px-3 py-2 self-start sm:self-auto\">\n                        <Briefcase className=\"w-3.5 h-3.5 text-[#e32b3c]\" />\n                        <span className=\"text-white/50 uppercase text-[10px]\">Delivered:</span>\n                        <span className=\"text-white truncate max-w-[220px] sm:max-w-none\">\n                          {current.project}\n                        </span>\n                      </div>\n\n                    </div>\n                  </motion.div>\n                </AnimatePresence>\n              </div>\n\n            </div>\n\n            {/* Bottom Interactive Control Strip */}\n            <div className=\"border-t border-white/[0.08] bg-black/40 px-6 sm:px-10 py-4 flex flex-col sm:flex-row items-center justify-between gap-4\">\n              \n              {/* Slide Counter & Progress */}\n              <div className=\"flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-start\">\n                <span className=\"font-mono text-xs text-white tracking-widest\">\n                  <span className=\"text-[#e32b3c]\">0{activeIndex + 1}</span>\n                  <span className=\"text-white/30\"> / 0{total}</span>\n                </span>\n\n                <div className=\"w-28 sm:w-36 h-1 bg-white/10 overflow-hidden\">\n                  <div\n                    className=\"h-full bg-[#e32b3c] transition-all duration-300\"\n                    style={{ width: `${progress}%` }}\n                  />\n                </div>\n\n                {/* Auto Play / Pause Toggle */}\n                <button\n                  type=\"button\"\n                  onClick={() => setIsPlaying((p) => !p)}\n                  className=\"flex items-center gap-1.5 text-[10px] font-mono uppercase text-[#a09c9a] hover:text-white transition-colors cursor-pointer px-2 py-1 bg-white/[0.02] border border-white/10\"\n                  title={isPlaying ? \'Pause auto-rotation\' : \'Resume auto-rotation\'}\n                >\n                  {isPlaying ? (\n                    <>\n                      <Pause className=\"w-3 h-3 text-[#e32b3c]\" />\n                      <span>Auto [On]</span>\n                    </>\n                  ) : (\n                    <>\n                      <Play className=\"w-3 h-3 text-white/50\" />\n                      <span>Auto [Paused]</span>\n                    </>\n                  )}\n                </button>\n              </div>\n\n              {/* Prev / Next Sharp Rectangular Navigation Buttons */}\n              <div className=\"flex items-center gap-2 w-full sm:w-auto justify-end\">\n                <button\n                  type=\"button\"\n                  onClick={handlePrev}\n                  aria-label=\"Previous testimonial\"\n                  className=\"px-3.5 py-2 bg-white/[0.03] hover:bg-[#e32b3c] hover:text-white border border-white/10 text-white font-mono text-xs transition-all cursor-pointer flex items-center gap-1 active:scale-95\"\n                >\n                  <ChevronLeft className=\"w-4 h-4\" />\n                  <span className=\"hidden sm:inline\">PREV</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={handleNext}\n                  aria-label=\"Next testimonial\"\n                  className=\"px-3.5 py-2 bg-white/[0.03] hover:bg-[#e32b3c] hover:text-white border border-white/10 text-white font-mono text-xs transition-all cursor-pointer flex items-center gap-1 active:scale-95\"\n                >\n                  <span className=\"hidden sm:inline\">NEXT</span>\n                  <ChevronRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n            </div>\n\n          </div>\n\n          {/* Direct Client Selector / Thumbnail Grid */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 pt-2\">\n            {testimonials.map((t, index) => {\n              const isSelected = index === activeIndex;\n              return (\n                <button\n                  key={t.id}\n                  type=\"button\"\n                  onClick={() => handleSelect(index)}\n                  className={`p-3.5 text-left transition-all duration-200 border cursor-pointer relative overflow-hidden backdrop-blur-md ${\n                    isSelected\n                      ? \'bg-white/[0.06] border-[#e32b3c] shadow-[0_0_15px_rgba(227,43,60,0.15)]\'\n                      : \'bg-[#121214]/50 border-white/[0.07] hover:border-white/20 hover:bg-white/[0.03]\'\n                  }`}\n                >\n                  {/* Active Indicator Top Line */}\n                  {isSelected && (\n                    <div className=\"absolute top-0 left-0 right-0 h-[2px] bg-[#e32b3c]\" />\n                  )}\n\n                  <div className=\"flex items-center justify-between gap-2 mb-2\">\n                    <span className=\"font-mono text-[10px] text-white/40\">\n                      0{index + 1}\n                    </span>\n                    <span className=\"text-[10px] font-mono text-[#e32b3c] font-semibold truncate\">\n                      {t.avatarInitials}\n                    </span>\n                  </div>\n\n                  <p className=\"font-sans font-medium text-xs text-white truncate\">\n                    {t.author}\n                  </p>\n                  <p className=\"text-[11px] text-[#a09c9a] truncate font-sans\">\n                    {t.company}\n                  </p>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Direct CTA Bridge to Contact */}\n          {onOpenContact && (\n            <div className=\"pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 p-5 bg-white/[0.02] border border-white/[0.06] backdrop-blur-md\">\n              <div className=\"text-center sm:text-left\">\n                <p className=\"text-sm text-white font-medium\">\n                  Have a similar design system or creative engineering challenge?\n                </p>\n                <p className=\"text-xs text-[#a09c9a] font-sans\">\n                  Let\'s discuss scope, deliverables, and production timelines.\n                </p>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={onOpenContact}\n                className=\"px-5 py-2.5 bg-[#e32b3c] hover:bg-[#c92232] text-white font-mono text-xs uppercase tracking-widest transition-all cursor-pointer shadow-lg shrink-0 active:scale-95\"\n              >\n                Start A Project\n              </button>\n            </div>\n          )}\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/TestimonialsSection.tsx"
        }
        overwrite: true
      }
    }
