        target_content: "  vx *= friction;\n  vy *= friction;\n\n  return {\n    ...particle,\n    x: particle.x + vx,\n    y: particle.y + vy,\n    vx,\n    vy,\n  };\n}"
        replacement_content: "  vx *= friction;\n  vy *= friction;\n\n  return {\n    ...particle,\n    x: particle.x + vx,\n    y: particle.y + vy,\n    vx,\n    vy,\n  };\n}\n\nexport interface CollidableParticle {\n  x: number;\n  y: number;\n  vx: number;\n  vy: number;\n  radius: number;\n  mass?: number;\n}\n\n/**\n * Resolves an elastic or semi-elastic collision between two 2D particles.\n * Returns true if a collision was detected and resolved.\n */\nexport function resolveParticleCollision(\n  p1: CollidableParticle,\n  p2: CollidableParticle,\n  restitution: number = 0.85,\n  spacingMargin: number = 2.0\n): boolean {\n  const dx = p2.x - p1.x;\n  const dy = p2.y - p1.y;\n  const distSq = dx * dx + dy * dy;\n  const minDist = p1.radius + p2.radius + spacingMargin;\n\n  if (distSq >= minDist * minDist || distSq <= 0.0001) {\n    return false;\n  }\n\n  const dist = Math.sqrt(distSq);\n  const nx = dx / dist;\n  const ny = dy / dist;\n\n  // Positional correction to resolve penetration\n  const overlap = (minDist - dist) * 0.5;\n  p1.x -= nx * overlap;\n  p1.y -= ny * overlap;\n  p2.x += nx * overlap;\n  p2.y += ny * overlap;\n\n  // Relative velocity along collision normal\n  const rvx = p2.vx - p1.vx;\n  const rvy = p2.vy - p1.vy;\n  const velAlongNormal = rvx * nx + rvy * ny;\n\n  // Do not resolve impulse if particles are already separating\n  if (velAlongNormal > 0) {\n    return true;\n  }\n\n  const m1 = p1.mass || (p1.radius * p1.radius);\n  const m2 = p2.mass || (p2.radius * p2.radius);\n\n  // Impulse scalar\n  const impulse = (-(1 + restitution) * velAlongNormal) / (1 / m1 + 1 / m2);\n\n  p1.vx -= (impulse / m1) * nx;\n  p1.vy -= (impulse / m1) * ny;\n  p2.vx += (impulse / m2) * nx;\n  p2.vy += (impulse / m2) * ny;\n\n  return true;\n}\n"
        start_line: 135
        end_line: 146
      }
      num_matches: 1
    }
    description: "Add CollidableParticle interface and resolveParticleCollision utility function"
    diff_stats {
      additions: 64
    }
  }
}
