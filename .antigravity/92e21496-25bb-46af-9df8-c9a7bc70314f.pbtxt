              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      title: \'Strategic Discovery & UX Mapping\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      description:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Auditing product friction, identifying mental models, and interviewing stakeholders to define concrete UX success metrics.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      deliverables: [\'User journey maps\', \'Problem statements\', \'Interaction benchmarks\'],"
