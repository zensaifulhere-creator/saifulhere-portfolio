              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ctx.lineWidth = 0.6;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (let a = 0; a < agitatedParticles.length; a++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          for (let b = a + 1; b < Math.min(a + 6, agitatedParticles.length); b++) {"
