            }
            lines {
              text: "      number: \'02\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      title: \'Information Architecture & Wireframes\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      description:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Structuring layouts with low-fidelity blueprints to test spatial hierarchy, scan paths, and cognitive load before visual styling.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      deliverables: [\'Clickable wireframes\', \'Information hierarchy\', \'Navigation flows\'],"
