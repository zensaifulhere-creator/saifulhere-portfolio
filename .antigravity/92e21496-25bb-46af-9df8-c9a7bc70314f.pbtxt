              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Positional correction to resolve penetration"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const overlap = (minDist - dist) * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
