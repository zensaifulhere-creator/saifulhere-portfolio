            }
            lines {
              text: "            const pA = agitatedParticles[a];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const pB = agitatedParticles[b];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const distSq = (pA.x - pB.x) ** 2 + (pA.y - pB.y) ** 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            if (distSq < 3200) {"
