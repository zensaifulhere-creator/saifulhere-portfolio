    content: "                  <ChevronRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n            </div>\n\n          </div>\n\n          {/* Direct Client Selector / Thumbnail Grid */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 pt-2\">\n            {testimonials.map((t, index) => {\n              const isSelected = index === activeIndex;\n              return (\n                <button\n                  key={t.id}\n                  type=\"button\"\n                  onClick={() => handleSelect(index)}\n                  className={`p-3.5 text-left transition-all duration-200 border cursor-pointer relative overflow-hidden backdrop-blur-md ${\n                    isSelected\n                      ? \'bg-white/[0.06] border-[#e32b3c] shadow-[0_0_15px_rgba(227,43,60,0.15)]\'\n                      : \'bg-[#121214]/50 border-white/[0.07] hover:border-white/20 hover:bg-white/[0.03]\'\n                  }`}\n                >\n                  {/* Active Indicator Top Line */}\n                  {isSelected && (\n                    <div className=\"absolute top-0 left-0 right-0 h-[2px] bg-[#e32b3c]\" />\n                  )}\n\n                  <div className=\"flex items-center justify-between gap-2 mb-2\">\n                    <span className=\"font-mono text-[10px] text-white/40\">\n                      0{index + 1}\n                    </span>\n                    <span className=\"text-[10px] font-mono text-[#e32b3c] font-semibold truncate\">\n                      {t.avatarInitials}\n                    </span>\n                  </div>\n\n                  <p className=\"font-sans font-medium text-xs text-white truncate\">\n                    {t.author}\n                  </p>\n                  <p className=\"text-[11px] text-[#a09c9a] truncate font-sans\">\n                    {t.company}\n                  </p>\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Direct CTA Bridge to Contact */}\n          {onOpenContact && (\n            <div className=\"pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 p-5 bg-white/[0.02] border border-white/[0.06] backdrop-blur-md\">\n              <div className=\"text-center sm:text-left\">\n                <p className=\"text-sm text-white font-medium\">\n                  Have a similar design system or creative engineering challenge?\n                </p>\n                <p className=\"text-xs text-[#a09c9a] font-sans\">\n                  Let\'s discuss scope, deliverables, and production timelines.\n                </p>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={onOpenContact}\n                className=\"px-5 py-2.5 bg-[#e32b3c] hover:bg-[#c92232] text-white font-mono text-xs uppercase tracking-widest transition-all cursor-pointer shadow-lg shrink-0 active:scale-95\"\n              >\n                Start A Project\n              </button>\n            </div>\n          )}\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
