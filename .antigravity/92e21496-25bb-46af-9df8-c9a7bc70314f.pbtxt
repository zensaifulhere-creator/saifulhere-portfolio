      thinking_signature: "\022\341\b\n\336\b\001i\024}\023\214\264\f\364)E#D\222\031\245\367\037\004\334=\343>H\024\243\203S1\303\215\n\276\257\023\255\222\330\221C\300R\246(\204\a\210\251\345l\225Q\216!\3565\311[\002:O\307\323\2749\022kb0-Y\371\234^\000\214\340\000\t\316\362\230,b9\343\315\322t{N\335\330*8\326g0\310\v\272^p\350\213\235\016\352\037*V0\317e\244\353\227?e\304\264r\371\016\024\v\350\252\321\210\251\004\n\036C\235+\322t\264A\003\304\022\b\033\357\346Q\276ud\v\207\375\303\017\226\252\2175\301O^\334\247\312\233/\036\353z\027G\336\352\242\321m\344\306\005\221\3457\222\353\021\367#\024\262F\254\031\266\254\315\313\224\205\367+\257=\271\322\220m\f\216*\342zaA\220\305\301\207E\262%.\210\313\365\'\361\353j\353\2732\327\260@\226;D\311\217S,\275\177\221\246\334\000\376\320\207\3570\237\216\317JI\'\350\255Qx\354\035\241G\240]\275\353\346\213W\"\331f\000\016\257\340\337Y\275\252\232_@\312%-\225\030#\005\266SG\305\212\aC2\274\311\350\2222\332]\336\324\301\321o\025Yk\372\0344\n\201\231\247j%\221\231v\376C<\211\f\374\001q\313G8\036\004\356mZC\004!\302\2424\271\3636\262\rc\350\327\0354\237i\000\253\333\332FK\'\301\222\231/\343\245)\202\354\365\211\232ZP\261x\234\3425\353\313\360\257\v\257\f\302\026\247\231\252\331\321sF<\v~\a:\244\244\274_\330\354\3136RU\0212^\252\021\006\267<g\320\242\202_\212\230\202j9]\3105c/\23411\022\275[\340\217\267\025\032\037\210!\217\350\314\353J\360.\000\255(\360\033\023\344w0Yu\335\344\210\365!L\260Cck\351\324JX|\255%V]\277\235\325\224\254yU61X\263\363\201\371\306\311$*\v\231(\'\273^4\207]\300\254t|+\244\314\033p\306>j\3764/\220\331\036\310\030W5\362\a\224\317\335\253\207\261J\\\237\az\035\222\200~\220\025\272\365\361\340|0\255\016j}\247\233\255\370<7],s\225\031T\374\276\243\244n9\001i\361\307*8\'P,\346B\366?\177\2024\032\032@\03167\242^[n\2549\321\0347\350\254| \353,H\227P\300\334O\3221\270\254\263*\343RZM9z\n\362\034\232\343\247]\3304\357L\345\b\b\232\026J\267\203\324\226\301\031\243@C\n%\321\247\221\256W5\237\004\262\372\302\312\321K\27