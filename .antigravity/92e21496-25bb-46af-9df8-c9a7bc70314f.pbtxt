              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      title: \'Edge-Case Polish & Sensory Tuning\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      description:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Stress-testing dark mode contrast, zero-latency states, keyboard focus traps, screen reader landmarks, and fluid responsive reflow.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      deliverables: [\'WCAG AA compliance audit\', \'Reduced-motion fallbacks\', \'Touch target optimization\'],"
