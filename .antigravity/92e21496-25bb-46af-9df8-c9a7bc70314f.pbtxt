      thinking_signature: "\022\211\r\n\206\r\001i\024}\023\276A\266y>#0-\316+\353\353v\357n\017\345\323\367\035\273\370\217)/i\250co\262n\245\272\217\004\367\321IF\251\277\225N\246\326\237h{\315D\274\251\022\371\327\312\265\0330\205\354\372z\314\214\274*|\242\273\372,\217\350\021\205\236l\332\3216\354\327g\325\001\366\002\274&e\345B\037\345\004\200~Lg\032\370m\356\361\201\356\334\bR\360LPE\212\317Z]C86\207\341\205\347\237\314\f!\303Je\026\255/M\354\220b<5\030\000\311 \'\2651\211\241\256\206\236\305\002\006\357+1\000\245\345\336\250M\036{wC*\371H\361O\376\322sr\206\034\020\033\213\375\\\377\275\2154\365\265\366\230\245\361\003\220\376ZF\017\320i\f\302\354`z\2743E\223\377<\205\247\373cJD\271q?\343;\031\233\310K\033\264v\232v8\205\3459\022\365X\0265\277\225\242%\342\205\331m\230o\242{&x\334P\275\327{U&%\325\003\267\256\335\032\313%\310\336\301\310Qu\267\2546\343\205V\327GQT%6\215\371\272\240\224\a\244yr\252\355w,j+\335K\021\256\264K^9!;v\206\263\021\t\214G\n\v(Z\322\001u\227\035\363\266\3107\024R\372\252\f\203\017\344\361\376\272v\\\210VG\350\227 \366\245Z\033b3\226\352.\34345\260\325\213(\323\032\353\037F\254\\\263\343\245\336l\330OzI\311\aAr\263\\BL\036\246lg\337x\225\232*\031\002\253./h\361\332T\001S\364;@\030PU)(;\232\315=d\256\301M[T^^Pv\n.\312\247\232,\244f\364t[f\220h/+\234y\200\307\366\372\237\301)\3126x\203\002\321\r\263YzZ2\335\374G\355S\355O\177\272\031\032+O\256W\274\304\344Y;\233[ePo\353\265kZt\251\343\314\313%\204Ss]\030\264\242}\363\000\305\232\210`\033[F\r@bq\252\315+\336\275\357p\342\272\246\364SHhd\330\301\'Q\221\003\213q\3133\255\274v\213F3H\024\314}\207\332\256\\\247\331\026\021\374\311T\201\252I\307-\n\311\320H\207\3151 L\036\3670.\037)\226\277w\342+\327\353\027\361\353\"\226\221\225\3347\000\005G\363\301[\306bg\202\302\267\354\243\241\377\341a\323r\"E\215\376\034\022\225\254\231\3328|\005d\017\204f\236\303\310\201\267c\327\230\312\355F\016\352B\320,\273QP\370\374X\306zd\313\002\227\310\302\305/<<\263x\016\215\006s\004\322N,\266\022-f\302O\n\034\3